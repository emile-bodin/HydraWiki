HYDRAWIKI_DATABASE_URL=postgresql://hydrawiki:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/hydrawiki
HYDRAWIKI_POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
HYDRAWIKI_QDRANT_URL=http://qdrant:6333
# Optional non-secret workload limits. The values shown are the typed backend defaults.
HYDRAWIKI_MAX_REPOSITORY_SIZE_BYTES=1073741824
HYDRAWIKI_MAX_SOURCE_FILES=25000
HYDRAWIKI_EMBEDDING_MAX_CONCURRENCY=2
HYDRAWIKI_INGEST_MAX_CONCURRENCY=1
HYDRAWIKI_GENERATION_MAX_CONCURRENCY=1
# Full OpenAI-compatible provider endpoint; HydraWiki posts to this URL exactly.
# Examples: http://host:4000/v1/chat/completions or http://host:4000/v1/responses
HYDRAWIKI_GENERATION_URL=http://litellm:4000/v1/chat/completions
HYDRAWIKI_GENERATION_MODEL=REPLACE_WITH_GENERATION_MODEL
# Optional when the compatible endpoint does not require bearer authentication.
HYDRAWIKI_GENERATION_API_KEY=REPLACE_WITH_GENERATION_API_KEY
HYDRAWIKI_GENERATION_TIMEOUT_SECONDS=60
HYDRAWIKI_GENERATION_PROMPT_VERSION=wiki-v1
HYDRAWIKI_GENERATION_MAX_OUTPUT_TOKENS=8000
HYDRAWIKI_GENERATION_MAX_SOURCE_CHARACTERS=100000
